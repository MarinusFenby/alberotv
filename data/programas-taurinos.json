import fs from "node:fs/promises";
import path from "node:path";

const VERSION = "2026-07-25-v6-domingos";
const URL =
  "https://www.canalsur.es/guia-programacion/canal-sur-television-79/";

const TITLE = "Toros para Todos";

const OUTPUT =
  path.resolve("data/programas-taurinos.json");

/*
  Número de domingos futuros que se mostrarán.

  12 domingos equivalen aproximadamente
  a tres meses de programación.
*/

const NUMBER_OF_SUNDAYS = 12;


/* ==================================================
   LIMPIAR HTML
   ================================================== */

function clean(html) {
  return String(html)
    .replace(
      /<script[\s\S]*?<\/script>/gi,
      " "
    )
    .replace(
      /<style[\s\S]*?<\/style>/gi,
      " "
    )
    .replace(
      /<[^>]+>/g,
      " "
    )
    .replace(
      /&nbsp;/gi,
      " "
    )
    .replace(
      /&amp;/gi,
      "&"
    )
    .replace(
      /&#39;/gi,
      "'"
    )
    .replace(
      /&quot;/gi,
      '"'
    )
    .replace(
      /\s+/g,
      " "
    )
    .trim();
}


/* ==================================================
   NORMALIZAR TEXTO
   ================================================== */

function normalize(text = "") {
  return String(text)
    .toLowerCase()
    .normalize("NFD")
    .replace(
      /[\u0300-\u036f]/g,
      ""
    )
    .replace(
      /\s+/g,
      " "
    )
    .trim();
}


/* ==================================================
   FECHA ACTUAL EN ESPAÑA
   ================================================== */

function todayInSpain() {
  return new Intl.DateTimeFormat(
    "en-CA",
    {
      timeZone: "Europe/Madrid",
      year: "numeric",
      month: "2-digit",
      day: "2-digit"
    }
  ).format(new Date());
}


/* ==================================================
   CONVERTIR FECHA A YYYY-MM-DD
   ================================================== */

function formatISODate(date) {
  return [
    date.getFullYear(),
    String(
      date.getMonth() + 1
    ).padStart(2, "0"),
    String(
      date.getDate()
    ).padStart(2, "0")
  ].join("-");
}


/* ==================================================
   CREAR FECHA LOCAL SIN PROBLEMAS DE UTC
   ================================================== */

function parseLocalDate(isoDate) {
  const [
    year,
    month,
    day
  ] = isoDate
    .split("-")
    .map(Number);

  return new Date(
    year,
    month - 1,
    day,
    12,
    0,
    0,
    0
  );
}


/* ==================================================
   CALCULAR EL PRÓXIMO DOMINGO

   Si hoy es domingo, utiliza hoy.
   Si no, avanza hasta el domingo siguiente.
   ================================================== */

function getNextSunday(isoDate) {
  const date =
    parseLocalDate(isoDate);

  const currentWeekday =
    date.getDay();

  const daysUntilSunday =
    currentWeekday === 0
      ? 0
      : 7 - currentWeekday;

  date.setDate(
    date.getDate() +
    daysUntilSunday
  );

  return date;
}


/* ==================================================
   GENERAR LOS PRÓXIMOS DOMINGOS
   ================================================== */

function getUpcomingSundays(
  startDate,
  amount
) {
  const firstSunday =
    getNextSunday(startDate);

  const sundays = [];

  for (
    let index = 0;
    index < amount;
    index++
  ) {
    const sunday =
      new Date(firstSunday);

    sunday.setDate(
      firstSunday.getDate() +
      index * 7
    );

    sundays.push(
      formatISODate(sunday)
    );
  }

  return sundays;
}


/* ==================================================
   ENCONTRAR LA HORA DEL PROGRAMA
   ================================================== */

function findTime(text) {
  const normalized =
    normalize(text);

  const normalizedTitle =
    normalize(TITLE);

  const titleIndex =
    normalized.indexOf(
      normalizedTitle
    );

  if (titleIndex === -1) {
    return "";
  }

  /*
    Buscamos alrededor del título para evitar
    confundir la hora con otros programas.
  */

  const nearby =
    normalized.slice(
      Math.max(
        0,
        titleIndex - 120
      ),
      titleIndex +
        normalizedTitle.length +
        120
    );

  /*
    Caso habitual:

    13:05 Toros para Todos
  */

  const before =
    nearby.match(
      /([01]?\d|2[0-3])[:.]([0-5]\d)(?=[^0-9]{0,60}toros para todos)/
    );

  if (before) {
    return (
      `${before[1].padStart(2, "0")}:` +
      `${before[2]}`
    );
  }

  /*
    Caso alternativo:

    Toros para Todos 13:05
  */

  const after =
    nearby.match(
      /toros para todos[^0-9]{0,60}([01]?\d|2[0-3])[:.]([0-5]\d)/
    );

  if (after) {
    return (
      `${after[1].padStart(2, "0")}:` +
      `${after[2]}`
    );
  }

  return "";
}


/* ==================================================
   CREAR EVENTO
   ================================================== */

function buildEvent(date, time) {
  return {
    id:
      `toros-para-todos-${date}-` +
      time.replace(":", ""),

    source:
      "Canal Sur",

    title:
      TITLE,

    type:
      "Programa taurino",

    contentType:
      "programa",

    date,

    time,

    channel:
      "Canal Sur Televisión",

    location:
      "Televisión",

    breeding:
      "",

    participants:
      [],

    sourceUrl:
      "https://www.canalsur.es/television/toros-para-todos/",

    eventUrl:
      "https://www.canalsur.es/television/directo-television/"
  };
}


/* ==================================================
   EJECUTAR SCRAPER
   ================================================== */

async function main() {
  const response =
    await fetch(
      URL,
      {
        headers: {
          "user-agent":
            "Mozilla/5.0 " +
            "(X11; Linux x86_64) " +
            "AppleWebKit/537.36 " +
            "(KHTML, like Gecko) " +
            "Chrome/126.0.0.0 " +
            "Safari/537.36",

          "accept-language":
            "es-ES,es;q=0.9"
        }
      }
    );

  if (!response.ok) {
    throw new Error(
      `Canal Sur respondió HTTP ${response.status}`
    );
  }

  const html =
    await response.text();

  const text =
    clean(html);

  const runDate =
    todayInSpain();

  const present =
    normalize(text).includes(
      normalize(TITLE)
    );

  const detectedTime =
    present
      ? findTime(text)
      : "";

  /*
    Si la guía detecta el programa pero no consigue
    leer la hora, mantenemos la hora conocida.

    Esto evita que desaparezca por un pequeño cambio
    en el HTML de Canal Sur.
  */

  const time =
    detectedTime ||
    (
      present
        ? "13:05"
        : ""
    );

  const sundays =
    present && time
      ? getUpcomingSundays(
          runDate,
          NUMBER_OF_SUNDAYS
        )
      : [];

  const events =
    sundays.map(
      date =>
        buildEvent(
          date,
          time
        )
    );

  const output = {
    scraperVersion:
      VERSION,

    source:
      "Programas taurinos",

    updatedAt:
      new Date().toISOString(),

    timeZone:
      "Europe/Madrid",

    date:
      runDate,

    checked:
      1,

    programsPresent:
      present ? 1 : 0,

    programsWithTime:
      time ? 1 : 0,

    emissionsFound:
      events.length,

    diagnostics: [
      {
        program:
          TITLE,

        source:
          "Canal Sur",

        guideUrl:
          URL,

        present,

        detectedTime:
          detectedTime || null,

        finalTime:
          time || null,

        recurringDay:
          "domingo",

        dates:
          sundays,

        eventsCreated:
          events.length
      }
    ],

    events
  };

  await fs.mkdir(
    path.dirname(OUTPUT),
    {
      recursive: true
    }
  );

  await fs.writeFile(
    OUTPUT,
    JSON.stringify(
      output,
      null,
      2
    ) + "\n"
  );

  console.log(
    `Versión: ${VERSION}`
  );

  console.log(
    `Encontrado: ${
      present
        ? "sí"
        : "no"
    }`
  );

  console.log(
    `Hora detectada: ${
      detectedTime ||
      "no encontrada"
    }`
  );

  console.log(
    `Hora utilizada: ${
      time ||
      "ninguna"
    }`
  );

  console.log(
    `Domingos creados: ${events.length}`
  );

  events.forEach(
    event => {
      console.log(
        `${event.date} · ` +
        `${event.time} · ` +
        `${event.title}`
      );
    }
  );
}


/* ==================================================
   CONTROL DE ERRORES
   ================================================== */

main().catch(
  error => {
    console.error(
      "Error ejecutando el scraper:",
      error
    );

    process.exit(1);
  }
);
